      ],
      "scripts": [],
      "calls": [],
      "hands_off_to": [],
      "requires": [],
      "state_reads": [],
      "state_writes": [],
      "folder": "commands/flawless-c",
      "needs_target": false,
      "confirms": false,
      "supports_preview": false,
