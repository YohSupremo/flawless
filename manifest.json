{
  "name": "clean-ui",
  "display_name": "Flawless",
  "identifier_note": "\"clean-ui\" is the internal skill identifier (SKILL.md name, historical state file names). The public name is Flawless. See docs/naming.md.",
  "version": "2.0",
  "router": "SKILL.md",
  "hooks": {
    "pre": {
      "snapshot": "python core/scripts/snapshot.py save <file>"
    },
    "post": {
      "audit": "python core/scripts/audit.py <file> --a11y --mobile",
      "state": "python core/scripts/state.py page <file> audit=<clean|errors>",
      "report": "one or two sentences; in session mode end with an audit line"
    }
  },
  "commands": {
    "flawless": {
      "description": "Turns the skill on for the whole conversation. `status` shows the session scheme and pages built; `off` turns it off",
      "example": "`/flawless`, `/flawless status`, `/flawless off`",
      "aliases": [],
      "modifies_files": false,
      "pre_hooks": [],
      "post_hooks": [],
      "reads": [
        "core/rules.md",
        "core/state.md",
        "core/hooks.md",
        "commands/flawless/references/session-mode.md",
        "commands/flawless/tokens/session-template.json"
      ],
      "scripts": [
        "core/scripts/state.py",
        "core/scripts/palette.py"
      ],
      "calls": [
        "palette"
      ],
      "hands_off_to": [],
      "requires": [],
      "state_reads": [
        "active",
        "scheme",
        "pages"
      ],
      "state_writes": [
        "active",
        "scheme"
      ],
      "folder": "commands/flawless",
      "needs_target": false,
      "confirms": false,
      "supports_preview": false,
      "output": "Session status: on or off, scheme, pages built",
      "common_failures": [
        "State file missing: rebuild with state.py init --scheme-from <page>"
      ],
      "related": [
        "flawless-c",
        "new",
        "edit"
      ]
    },
    "flawless-c": {
      "description": "Lists every command with its description",
      "example": "`/flawless-c`",
      "aliases": [
        "help"
      ],
      "modifies_files": false,
      "pre_hooks": [],
      "post_hooks": [],
      "reads": [
        "commands/flawless-c/references/usage.md",
